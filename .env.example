# Pañol 3: configuración del servidor. Copiar a `.env` y ajustar. Nunca subir `.env`.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL. En desarrollo, si apunta a este equipo y no responde, `npm run db:start`,
# `db:migrate` y `db:reset` usan el PostgreSQL local de `.pgdata/` (embedded-postgres).
# La contraseña de abajo es solo de desarrollo local.
DATABASE_URL=postgres://postgres:panol-dev@127.0.0.1:54329/panol

# Origen público de la app (para validar Origin en pedidos que modifican datos).
# Si se deja vacío, se compara con el Host del pedido.
APP_ORIGIN=http://localhost:3000

# Detrás de Caddy/Nginx: true para tomar la IP real del cliente.
TRUST_PROXY=false

# Solo en development/test se puede desactivar Secure de la cookie (http://localhost).
COOKIE_SECURE=false

# Sesiones: inactividad (minutos) y duración máxima (horas) de una sesión común;
# días de "Mantener la sesión".
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=24
SESSION_REMEMBER_DAYS=30

# Pruebas de integración en CI: servidor PostgreSQL donde se crean bases temporales.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
