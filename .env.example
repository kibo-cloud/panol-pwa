# Pañol 3: configuración del servidor. Copiar a `.env` y ajustar. Nunca subir `.env`.

# development | test | production. Sin NODE_ENV el servidor se toma como producción: exige
# APP_ORIGIN y DATABASE_URL, la cookie es siempre Secure y `db:reset`/`db:start` y la semilla
# de desarrollo no corren. En desarrollo, dejá NODE_ENV=development.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL. La app se conecta con el rol `panol_app` (lo crea la migración 003: sin
# privilegios de dueño, sin UPDATE/DELETE en el libro de movimientos ni en la auditoría).
# Las migraciones las aplica el dueño de las tablas con MIGRATION_DATABASE_URL, y en el mismo
# paso se habilita `panol_app` con la contraseña de DATABASE_URL.
# En desarrollo, si apuntan a este equipo y no responde, `npm run db:start`, `db:migrate` y
# `db:reset` usan el PostgreSQL local de `.pgdata/` (embedded-postgres).
# Las contraseñas de abajo son solo de desarrollo local.
DATABASE_URL=postgres://panol_app:panol-app-dev@127.0.0.1:54329/panol
MIGRATION_DATABASE_URL=postgres://postgres:panol-dev@127.0.0.1:54329/panol

# Origen público de la app (para validar Origin en pedidos que modifican datos).
# Obligatorio en producción. En desarrollo, si se deja vacío, se compara con el Host del pedido.
APP_ORIGIN=http://localhost:3000

# Detrás de Caddy/Nginx: true para tomar la IP real del cliente.
TRUST_PROXY=false

# Solo en development/test se puede desactivar Secure de la cookie (http://localhost).
COOKIE_SECURE=false

# Sesiones: inactividad (minutos) y duración máxima (horas) de una sesión común;
# días de "Mantener la sesión".
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=24
SESSION_REMEMBER_DAYS=30

# `npm run db:reset` carga datos inventados con estos usuarios de desarrollo
# (server/scripts/seed.js), todos con la contraseña `panol-dev-1234`:
#   admin, gerencia, supervisor, responsable, responsable2, consulta
# Solo existen en la base local; nunca usar estas credenciales en producción.

# Pruebas de integración en CI: servidor PostgreSQL donde se crean bases temporales (con un
# superusuario: las pruebas crean el rol `panol_app` y lo usan para la app).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
