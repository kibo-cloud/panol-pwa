{
  "name": "Pañol: control de herramientas",
  "short_name": "Pañol",
  "description": "Control semanal de herramientas por técnico, entregas, reposiciones e inventario. Funciona sin conexión.",
  "id": "./",
  "start_url": "./#inicio",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F4F5F7",
  "theme_color": "#101828",
  "lang": "es-AR",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Controlar", "short_name": "Controlar", "url": "./#control", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Entregas y reposiciones", "short_name": "Entregas", "url": "./#entregas", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alertas", "short_name": "Alertas", "url": "./#alertas", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    { "action": "./#inicio", "accept": { "text/plain": [".txt"] } }
  ]
}
