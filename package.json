{
  "name": "panol",
  "version": "3.0.0-dev",
  "private": true,
  "description": "Pañol 3: control de herramientas (servidor + PWA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/src/main.js",
    "dev": "node web/scripts/dev.mjs",
    "build": "vite build",
    "db:start": "node server/scripts/db-start.js",
    "db:stop": "node server/scripts/db-stop.js",
    "db:migrate": "node server/scripts/db-migrate.js",
    "db:reset": "node server/scripts/db-reset.js",
    "test": "node --env-file=server/test/test.env --test \"server/test/unit/**/*.test.js\" \"web/test/**/*.test.js\"",
    "test:db": "node --env-file=server/test/test.env --test --test-concurrency=2 \"server/test/integration/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "embedded-postgres": "16.14.0-beta.17",
    "jspdf": "2.5.1",
    "vite": "7.3.7",
    "xlsx": "0.18.5"
  }
}
